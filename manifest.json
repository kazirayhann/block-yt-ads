{
  "manifest_version": 3,
  "name": "CleanTube Ad Hider",
  "version": "1.4.1",
  "description": "Hides YouTube ad overlays and automatically skips skippable video ads.",
  "permissions": ["storage", "declarativeNetRequest"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "*://*.doubleclick.net/*",
    "*://*.googlesyndication.com/*",
    "*://*.googleadservices.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "youtube_ad_servers",
        "enabled": true,
        "path": "rules/ad-servers.json"
      }
    ]
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "CleanTube Ad Hider",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": ["src/injected/player-interceptor.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": ["src/content/content.js"],
      "css": ["src/content/content.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
